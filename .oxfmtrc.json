{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "sortTailwindcss": {
    "stylesheet": "./app/globals.css"
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    ".next/**",
    ".open-next/**",
    ".wrangler/**",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    "cloudflare-env.d.ts"
  ]
}
